{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/duyet/herdr-desk/main/herdr-desk.schema.json",
  "title": "herdr-desk repo config",
  "description": "Usually { name }. Defaults: playbook github-issues, job id desk:github-issues, schedule 0 7 * * *, 5 worktrees, <name>-desk. extra is inline markdown or a .md path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "repo": { "type": "string" },
    "playbook": {
      "type": "string",
      "description": "Bundled id (github-issues), a .md path, or inline markdown."
    },
    "extra": {
      "type": "string",
      "description": "Repo addendum. Inline markdown, or a path if that file exists."
    },
    "schedule": { "$ref": "#/$defs/schedule" },
    "maxChildren": { "type": "integer", "minimum": 1, "maximum": 8, "default": 5 },
    "agentName": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
    "kind": { "type": "string", "default": "grok" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "cron": {
      "type": "string",
      "pattern": "^\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+$"
    },
    "schedule": {
      "description": "When to run. One cron, or several crons that all run this playbook.",
      "oneOf": [
        { "$ref": "#/$defs/cron" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cron" }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Job handle. desk: for a bundled playbook, local: for a repo-owned prompt."
        },
        "label": { "type": "string" },
        "playbook": {
          "type": "string",
          "description": "Bundled id (github-issues), a .md path, or inline markdown."
        },
        "agentName": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "kind": { "type": "string" },
        "maxChildren": { "type": "integer", "minimum": 1, "maximum": 8 },
        "stateDir": { "type": "string" },
        "extra": { "type": "string" },
        "describe": { "type": "string" },
        "schedule": { "$ref": "#/$defs/schedule" }
      }
    }
  },
  "examples": [
    { "name": "my-repo" },
    {
      "name": "my-repo",
      "tasks": [
        {
          "id": "desk:github-issues",
          "playbook": "github-issues",
          "schedule": "0 8 * * *",
          "extra": "Children never deploy. Manager deploys from main."
        }
      ]
    }
  ]
}
