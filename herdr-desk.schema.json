{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/duyet/herdr-desk/main/herdr-desk.schema.json",
  "title": "herdr-desk repo config",
  "description": "Usually just { name }. Defaults: github-issues, morning 07:00, 5 worktrees, <name>-desk. extraPrompt is inline markdown or a .md path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "repo": { "type": "string" },
    "extraPrompt": {
      "type": "string",
      "description": "Addendum. Inline markdown, or a path to a .md/.txt file if that file exists."
    },
    "schedule": { "$ref": "#/$defs/schedule" },
    "maxChildren": { "type": "integer", "minimum": 1, "maximum": 8, "default": 5 },
    "agentName": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
    "kind": { "type": "string", "default": "grok" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "cron": {
      "type": "string",
      "pattern": "^\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+$"
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "morning": { "$ref": "#/$defs/cron" },
        "nightly": { "$ref": "#/$defs/cron" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "task": {
          "type": "string",
          "description": "Playbook id (github-issues), a .md path, or inline markdown."
        },
        "agentName": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "kind": { "type": "string" },
        "maxChildren": { "type": "integer", "minimum": 1, "maximum": 8 },
        "stateDir": { "type": "string" },
        "extraPrompt": {
          "type": "string",
          "description": "Inline markdown or a .md path."
        },
        "describe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "morning": { "type": "string" },
            "nightly": { "type": "string" }
          }
        },
        "schedule": { "$ref": "#/$defs/schedule" }
      }
    }
  },
  "examples": [
    { "name": "my-repo" },
    {
      "name": "my-repo",
      "extraPrompt": "Children never deploy. Manager deploys from main.",
      "schedule": { "morning": "0 8 * * *" }
    }
  ]
}
